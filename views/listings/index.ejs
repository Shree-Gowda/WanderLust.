<% layout("/layouts/boilerplate") %>

<div class="listings-page">

  <!-- Page Header -->
  <div class="listings-header">
    <div class="container" style="max-width:1400px; margin:0 auto; padding:0 2rem;">
      <div class="listings-header-inner">
        <div class="listings-header-text">
          <span class="listings-badge"><i class="fa-solid fa-compass"></i> Explore</span>
          <h1 class="listings-title">Find your perfect stay</h1>
          <p class="listings-subtitle">Discover <strong><%= allListings.length %></strong> handpicked places across the world</p>
        </div>
        <div class="listings-header-search">
          <div class="listings-search-bar">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="listing-search" placeholder="Search destinations, titles…" autocomplete="off" />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Chips -->
  <div class="listings-filters">
    <div class="container" style="max-width:1400px; margin:0 auto; padding:0 2rem;">
      <div class="filter-chips" id="filter-chips">
        <button class="filter-chip active" data-filter="all" onclick="filterChip(this,'all')">
          <i class="fa-solid fa-border-all"></i> All
        </button>
        <button class="filter-chip" data-filter="beach" onclick="filterChip(this,'beach')">
          <i class="fa-solid fa-umbrella-beach"></i> Beach
        </button>
        <button class="filter-chip" data-filter="mountain" onclick="filterChip(this,'mountain')">
          <i class="fa-solid fa-mountain"></i> Mountains
        </button>
        <button class="filter-chip" data-filter="city" onclick="filterChip(this,'city')">
          <i class="fa-solid fa-city"></i> City
        </button>
        <button class="filter-chip" data-filter="cabin" onclick="filterChip(this,'cabin')">
          <i class="fa-solid fa-house-chimney"></i> Cabins
        </button>
        <button class="filter-chip" data-filter="lake" onclick="filterChip(this,'lake')">
          <i class="fa-solid fa-water"></i> Lakeside
        </button>
        <button class="filter-chip" data-filter="luxury" onclick="filterChip(this,'luxury')">
          <i class="fa-solid fa-gem"></i> Luxury
        </button>
      </div>
    </div>
  </div>

  <!-- Grid -->
  <div class="listings-grid-section">
    <div class="container" style="max-width:1400px; margin:0 auto; padding:0 2rem;">
      <div class="listings-grid" id="listings-grid">
        <% for (let listing of allListings) { %>
          <div class="listing-item" id="listing-<%= listing._id %>">
            <a href="/listings/<%= listing._id %>" class="listing-card-link">
              <div class="wl-listing-card">
                <!-- Image -->
                <div class="wl-listing-img-wrap">
                  <img
                    src="<%= listing.image.url %>"
                    alt="<%= listing.title %>"
                    class="wl-listing-img"
                    loading="lazy"
                  />
                  <div class="wl-listing-overlay">
                    <span class="wl-listing-explore-btn">
                      <i class="fa-solid fa-arrow-up-right-from-square"></i> View
                    </span>
                  </div>
                  <button class="wl-listing-wishlist" aria-label="Save to wishlist" onclick="toggleWishlist(this, event)">
                    <i class="fa-regular fa-heart"></i>
                  </button>
                  <div class="wl-listing-price-badge">
                    ₹<%= listing.price.toLocaleString("en-IN") %><span>/night</span>
                  </div>
                </div>

                <!-- Info -->
                <div class="wl-listing-info">
                  <div class="wl-listing-meta">
                    <h3 class="wl-listing-title"><%= listing.title %></h3>
                    <div class="wl-listing-rating">
                      <i class="fa-solid fa-star"></i>
                      <span><%= (4.5 + Math.random() * 0.5).toFixed(1) %></span>
                    </div>
                  </div>
                  <p class="wl-listing-location">
                    <i class="fa-solid fa-location-dot"></i>
                    <%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %>
                  </p>
                </div>
              </div>
            </a>
          </div>
        <% } %>
      </div>

      <!-- Empty State -->
      <div class="listings-empty" id="listings-empty" style="display:none;">
        <div class="empty-icon"><i class="fa-solid fa-compass"></i></div>
        <h3>No listings found</h3>
        <p>Try adjusting your search or filters</p>
        <button onclick="resetFilters()" class="empty-reset-btn">Clear filters</button>
      </div>
    </div>
  </div>

</div>

<script>
  // Live search filter
  document.getElementById('listing-search').addEventListener('input', function() {
    applyFilters();
  });

  function filterChip(el, filter) {
    document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
    applyFilters();
  }

  function applyFilters() {
    const searchVal = document.getElementById('listing-search').value.toLowerCase();
    const activeChip = document.querySelector('.filter-chip.active');
    const activeFilter = activeChip ? activeChip.dataset.filter : 'all';

    const items = document.querySelectorAll('.listing-item');
    let visibleCount = 0;

    items.forEach(item => {
      const title = item.querySelector('.wl-listing-title')?.textContent.toLowerCase() || '';
      const location = item.querySelector('.wl-listing-location')?.textContent.toLowerCase() || '';
      const combined = title + ' ' + location;

      const matchesSearch = searchVal === '' || combined.includes(searchVal);
      const matchesFilter = activeFilter === 'all' || combined.includes(activeFilter);

      if (matchesSearch && matchesFilter) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    document.getElementById('listings-empty').style.display = visibleCount === 0 ? 'flex' : 'none';
  }

  function resetFilters() {
    document.getElementById('listing-search').value = '';
    document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
    document.querySelector('.filter-chip[data-filter="all"]').classList.add('active');
    applyFilters();
  }

  // Wishlist toggle
  function toggleWishlist(btn, e) {
    e.preventDefault();
    const icon = btn.querySelector('i');
    if (icon.classList.contains('fa-regular')) {
      icon.className = 'fa-solid fa-heart';
      btn.classList.add('wishlisted');
    } else {
      icon.className = 'fa-regular fa-heart';
      btn.classList.remove('wishlisted');
    }
  }

  // Animate cards on scroll
  const listingObserver = new IntersectionObserver((entries) => {
    entries.forEach((e, idx) => {
      if (e.isIntersecting) {
        const delay = Math.min(idx * 40, 200);
        setTimeout(() => {
          e.target.style.opacity = '1';
          e.target.style.transform = 'translateY(0)';
        }, delay);
        listingObserver.unobserve(e.target);
      }
    });
  }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('.listing-item').forEach((el, i) => {
    // Only animate if below the fold; show top cards immediately
    if (el.getBoundingClientRect().top < window.innerHeight) {
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
    } else {
      el.style.opacity = '0';
      el.style.transform = 'translateY(28px)';
      el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      listingObserver.observe(el);
    }
  });
</script>