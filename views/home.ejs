  <div class="container">
    <div class="app-content">
      <div class="app-text">
        <span class="section-badge">Mobile App</span>
        <h2>Travel smarter with our app</h2>
        <p>Download the WanderLust app and manage your bookings, discover deals, and communicate with hosts — all on the go.</p>
        <div class="app-badges">
          <a href="#" class="app-badge-btn" id="app-store-btn">
            <i class="fa-brands fa-apple"></i>
            <div><span>Download on</span><strong>App Store</strong></div>
          </a>
          <a href="#" class="app-badge-btn" id="play-store-btn">
            <i class="fa-brands fa-google-play"></i>
            <div><span>Get it on</span><strong>Google Play</strong></div>
          </a>
        </div>
      </div>
      <div class="app-mockup">
        <div class="phone-frame">
          <div class="phone-screen">
            <div class="phone-top-bar"></div>
            <div class="phone-listing-card">
              <div class="phone-img"></div>
