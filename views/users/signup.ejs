<% layout("/layouts/boilerplate") %>

<div class="auth-page">
  <!-- Left Visual Panel -->
  <div class="auth-visual">
    <div class="auth-visual-overlay"></div>
    <div class="auth-visual-content">
      <a href="/" class="auth-brand">
        <div class="auth-brand-icon"><i class="fa-solid fa-compass"></i></div>
        <span>WanderLust</span>
      </a>
      <div class="auth-visual-quote">
        <div class="quote-stars">
          <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
        </div>
        <blockquote>"Join thousands of travelers discovering extraordinary stays around the world."</blockquote>
        <div class="quote-author">
          <div class="qa-avatar" style="background:linear-gradient(135deg,#667eea,#764ba2)">J</div>
          <div>
            <strong>Join WanderLust</strong>
            <span>Free — no credit card required</span>
          </div>
        </div>
      </div>
      <div class="auth-visual-stats">
        <div class="avs-item"><strong>10K+</strong><span>Listings</span></div>
        <div class="avs-divider"></div>
        <div class="avs-item"><strong>50K+</strong><span>Travelers</span></div>
        <div class="avs-divider"></div>
        <div class="avs-item"><strong>120+</strong><span>Countries</span></div>
      </div>
    </div>
  </div>

  <!-- Right Form Panel -->
  <div class="auth-form-panel">
    <div class="auth-form-box" id="signup-form-box">

      <div class="auth-form-header">
        <div class="auth-form-icon" style="background:linear-gradient(135deg,#667eea,#764ba2)"><i class="fa-solid fa-user-plus"></i></div>
        <h1 class="auth-form-title">Create account</h1>
        <p class="auth-form-sub">Start your journey with WanderLust today</p>
      </div>

      <form action="/signup" method="POST" class="auth-form needs-validation" autocomplete="off" novalidate id="signup-form">

        <!-- Username -->
        <div class="auth-field" id="su-field-username">
          <label for="username" class="auth-label">
            <i class="fa-solid fa-user"></i> Username
          </label>
          <div class="auth-input-wrap">
            <input
              name="username"
              id="username"
              type="text"
              class="auth-input"
              placeholder="Choose a username"
              autocomplete="new-username"
              required
              minlength="3"
              maxlength="30"
              pattern="[a-zA-Z0-9_]+"
            />
            <span class="auth-input-icon valid-icon"><i class="fa-solid fa-circle-check"></i></span>
            <span class="auth-input-icon invalid-icon"><i class="fa-solid fa-circle-xmark"></i></span>
          </div>
          <div class="auth-hint">Letters, numbers and underscores only</div>
          <div class="auth-feedback auth-valid-feedback">
            <i class="fa-solid fa-circle-check"></i> Great username!
          </div>
          <div class="auth-feedback auth-invalid-feedback" id="username-invalid-msg">
            <i class="fa-solid fa-triangle-exclamation"></i> <span id="username-invalid-text">Username must be 3–30 characters (letters, numbers, _ only)</span>
          </div>
        </div>

        <!-- Email -->
        <div class="auth-field" id="su-field-email">
          <label for="email" class="auth-label">
            <i class="fa-solid fa-envelope"></i> Email address
          </label>
          <div class="auth-input-wrap">
            <input
              name="email"
              id="email"
              type="email"
              class="auth-input"
              placeholder="you@example.com"
              autocomplete="off"
              required
            />
            <span class="auth-input-icon valid-icon"><i class="fa-solid fa-circle-check"></i></span>
            <span class="auth-input-icon invalid-icon"><i class="fa-solid fa-circle-xmark"></i></span>
          </div>
          <div class="auth-feedback auth-valid-feedback">
            <i class="fa-solid fa-circle-check"></i> Valid email address!
          </div>
          <div class="auth-feedback auth-invalid-feedback">
            <i class="fa-solid fa-triangle-exclamation"></i> Please enter a valid email address
          </div>
        </div>

        <!-- Password -->
        <div class="auth-field" id="su-field-password">
          <label for="password" class="auth-label">
            <i class="fa-solid fa-lock"></i> Password
          </label>
          <div class="auth-input-wrap">
            <input
              name="password"
              id="password"
              type="password"
              class="auth-input"
              placeholder="Create a strong password"
              autocomplete="new-password"
              required
              minlength="6"
              id="su-password"
            />
            <span class="auth-input-icon valid-icon"><i class="fa-solid fa-circle-check"></i></span>
            <span class="auth-input-icon invalid-icon"><i class="fa-solid fa-circle-xmark"></i></span>
            <button type="button" class="auth-toggle-password" id="su-toggle-password" aria-label="Toggle password">
              <i class="fa-solid fa-eye" id="su-toggle-eye"></i>
            </button>
          </div>

          <!-- Strength Meter -->
          <div class="password-strength-wrap" id="strength-wrap" style="display:none">
            <div class="strength-bar">
              <div class="strength-fill" id="strength-fill"></div>
            </div>
            <span class="strength-label" id="strength-label">Weak</span>
          </div>

          <div class="auth-feedback auth-valid-feedback">
            <i class="fa-solid fa-circle-check"></i> Strong password!
          </div>
          <div class="auth-feedback auth-invalid-feedback">
            <i class="fa-solid fa-triangle-exclamation"></i> Password must be at least 6 characters
          </div>
        </div>

        <button type="submit" class="auth-submit-btn su-btn" id="signup-submit-btn">
          <span class="btn-text">Create Account</span>
          <i class="fa-solid fa-arrow-right btn-arrow"></i>
          <div class="btn-loader" style="display:none;"><i class="fa-solid fa-circle-notch fa-spin"></i></div>
        </button>

        <p class="auth-terms">
          By signing up, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
        </p>
      </form>

      <div class="auth-divider"><span>Already have an account?</span></div>
      <a href="/login" class="auth-switch-btn" id="go-to-login">
        <i class="fa-solid fa-right-to-bracket"></i> Sign in instead
      </a>
    </div>
  </div>
</div>

<script>
  // Password toggle
  document.getElementById('su-toggle-password').addEventListener('click', function() {
    const input = document.getElementById('password');
    const icon = document.getElementById('su-toggle-eye');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fa-solid fa-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'fa-solid fa-eye';
    }
  });

  // Password strength meter
  document.getElementById('password').addEventListener('input', function() {
    const val = this.value;
    const wrap = document.getElementById('strength-wrap');
    const fill = document.getElementById('strength-fill');
    const label = document.getElementById('strength-label');

    if (val.length === 0) { wrap.style.display = 'none'; return; }
    wrap.style.display = 'flex';

    let score = 0;
    if (val.length >= 6) score++;
    if (val.length >= 10) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^a-zA-Z0-9]/.test(val)) score++;

    const levels = [
      { pct:'20%', color:'#e31c5f', text:'Very Weak' },
      { pct:'40%', color:'#ff6b35', text:'Weak' },
      { pct:'60%', color:'#ffd700', text:'Fair' },
      { pct:'80%', color:'#4ade80', text:'Good' },
      { pct:'100%', color:'#22c55e', text:'Strong' }
    ];
    const lv = levels[Math.min(score, 4)];
    fill.style.width = lv.pct;
    fill.style.background = lv.color;
    label.textContent = lv.text;
    label.style.color = lv.color;
  });

  // Live validation
  document.querySelectorAll('.auth-input').forEach(input => {
    input.addEventListener('input', function() {
      const field = this.closest('.auth-field');
      if (this.validity.valid && this.value.length > 0) {
        field.classList.add('is-valid');
        field.classList.remove('is-invalid');
      } else if (this.value.length > 0) {
        field.classList.add('is-invalid');
        field.classList.remove('is-valid');
      } else {
        field.classList.remove('is-valid', 'is-invalid');
      }
    });
  });

  // Submit loader
  document.getElementById('signup-form').addEventListener('submit', function(e) {
    if (this.checkValidity()) {
      const btn = document.getElementById('signup-submit-btn');
      btn.querySelector('.btn-text').textContent = 'Creating account…';
      btn.querySelector('.btn-arrow').style.display = 'none';
      btn.querySelector('.btn-loader').style.display = 'inline-block';
      btn.disabled = true;
    }
  });
</script>