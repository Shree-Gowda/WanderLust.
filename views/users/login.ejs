<% layout("/layouts/boilerplate") %>

<div class="auth-page">
  <!-- Left Visual Panel -->
  <div class="auth-visual">
    <div class="auth-visual-overlay"></div>
    <div class="auth-visual-content">
      <a href="/" class="auth-brand">
        <div class="auth-brand-icon"><i class="fa-solid fa-compass"></i></div>
        <span>WanderLust</span>
      </a>
      <div class="auth-visual-quote">
        <div class="quote-stars">
          <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
        </div>
        <blockquote>"Every journey starts with a single step — and the perfect place to stay."</blockquote>
        <div class="quote-author">
          <div class="qa-avatar" style="background:linear-gradient(135deg,#ff385c,#e31c5f)">W</div>
          <div>
            <strong>WanderLust</strong>
            <span>Your world, beautifully hosted</span>
          </div>
        </div>
      </div>
      <div class="auth-visual-stats">
        <div class="avs-item"><strong>10K+</strong><span>Listings</span></div>
        <div class="avs-divider"></div>
        <div class="avs-item"><strong>50K+</strong><span>Travelers</span></div>
        <div class="avs-divider"></div>
        <div class="avs-item"><strong>120+</strong><span>Countries</span></div>
      </div>
    </div>
  </div>

  <!-- Right Form Panel -->
  <div class="auth-form-panel">
    <div class="auth-form-box" id="login-form-box">

      <div class="auth-form-header">
        <div class="auth-form-icon"><i class="fa-solid fa-right-to-bracket"></i></div>
        <h1 class="auth-form-title">Welcome back</h1>
        <p class="auth-form-sub">Sign in to continue your journey</p>
      </div>

      <form action="/login" method="POST" class="auth-form needs-validation" autocomplete="off" novalidate id="login-form">

        <!-- Username -->
        <div class="auth-field" id="field-username">
          <label for="username" class="auth-label">
            <i class="fa-solid fa-user"></i> Username
          </label>
          <div class="auth-input-wrap">
            <input
              name="username"
              id="username"
              type="text"
              class="auth-input"
              placeholder="Enter your username"
              autocomplete="new-username"
              required
              minlength="3"
            />
            <span class="auth-input-icon valid-icon"><i class="fa-solid fa-circle-check"></i></span>
            <span class="auth-input-icon invalid-icon"><i class="fa-solid fa-circle-xmark"></i></span>
          </div>
          <div class="auth-feedback auth-valid-feedback">
            <i class="fa-solid fa-circle-check"></i> Looks great!
          </div>
          <div class="auth-feedback auth-invalid-feedback">
            <i class="fa-solid fa-triangle-exclamation"></i> Please enter your username (min 3 chars)
          </div>
        </div>

        <!-- Password -->
        <div class="auth-field" id="field-password">
          <label for="password" class="auth-label">
            <i class="fa-solid fa-lock"></i> Password
          </label>
          <div class="auth-input-wrap">
            <input
              name="password"
              id="password"
              type="password"
              class="auth-input"
              placeholder="Enter your password"
              autocomplete="new-password"
              required
              minlength="6"
            />
            <span class="auth-input-icon valid-icon"><i class="fa-solid fa-circle-check"></i></span>
            <span class="auth-input-icon invalid-icon"><i class="fa-solid fa-circle-xmark"></i></span>
            <button type="button" class="auth-toggle-password" id="toggle-password" aria-label="Toggle password visibility">
              <i class="fa-solid fa-eye" id="toggle-eye"></i>
            </button>
          </div>
          <div class="auth-feedback auth-valid-feedback">
            <i class="fa-solid fa-circle-check"></i> Password looks good!
          </div>
          <div class="auth-feedback auth-invalid-feedback">
            <i class="fa-solid fa-triangle-exclamation"></i> Password must be at least 6 characters
          </div>
        </div>

        <button type="submit" class="auth-submit-btn" id="login-submit-btn">
          <span class="btn-text">Sign In</span>
          <i class="fa-solid fa-arrow-right btn-arrow"></i>
          <div class="btn-loader" style="display:none;"><i class="fa-solid fa-circle-notch fa-spin"></i></div>
        </button>

      </form>

      <div class="auth-divider"><span>New to WanderLust?</span></div>
      <a href="/signup" class="auth-switch-btn" id="go-to-signup">
        <i class="fa-solid fa-user-plus"></i> Create an account
      </a>
    </div>
  </div>
</div>

<script>
  // Password toggle
  document.getElementById('toggle-password').addEventListener('click', function() {
    const input = document.getElementById('password');
    const icon = document.getElementById('toggle-eye');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fa-solid fa-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'fa-solid fa-eye';
    }
  });

  // Live validation feedback
  document.querySelectorAll('.auth-input').forEach(input => {
    input.addEventListener('input', function() {
      const field = this.closest('.auth-field');
      if (this.validity.valid && this.value.length > 0) {
        field.classList.add('is-valid');
        field.classList.remove('is-invalid');
      } else if (this.value.length > 0) {
        field.classList.add('is-invalid');
        field.classList.remove('is-valid');
      } else {
        field.classList.remove('is-valid', 'is-invalid');
      }
    });
  });

  // Submit loader
  document.getElementById('login-form').addEventListener('submit', function(e) {
    if (this.checkValidity()) {
      const btn = document.getElementById('login-submit-btn');
      btn.querySelector('.btn-text').textContent = 'Signing in…';
      btn.querySelector('.btn-arrow').style.display = 'none';
      btn.querySelector('.btn-loader').style.display = 'inline-block';
      btn.disabled = true;
    }
  });
</script>